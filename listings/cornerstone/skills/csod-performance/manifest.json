{
  "resourceId": {
    "urn": "urn:vam:skill:hub.squrell.cloud/squrell/csod-performance"
  },
  "version": {
    "major": 1,
    "minor": 0,
    "patch": 1
  },
  "description": "Read performance reviews and manage goals in Cornerstone; member must be signed into VAM; writes ask first.",
  "requiresConnector": "urn:vam:connector:hub.squrell.cloud/squrell/cornerstone",
  "tools": [
    {
      "name": "review_get",
      "description": "Get performance review details.",
      "inputSchemaJson": "{\"type\":\"object\",\"properties\":{},\"required\":[],\"additionalProperties\":true}",
      "outputSchemaJson": "{\"type\":\"object\"}",
      "sideEffect": "SIDE_EFFECT_CLASS_READ_ONLY",
      "localExec": {
        "command": "bun",
        "entrypoint": "./review_get.ts"
      },
      "egress": [
        {
          "binding": "csod",
          "host": "{subdomain}.csod.com",
          "methods": [
            "GET"
          ],
          "pathPrefixes": [
            "/services/api/Review"
          ]
        }
      ]
    },
    {
      "name": "goal_get",
      "description": "Get goal details.",
      "inputSchemaJson": "{\"type\":\"object\",\"properties\":{},\"required\":[],\"additionalProperties\":true}",
      "outputSchemaJson": "{\"type\":\"object\"}",
      "sideEffect": "SIDE_EFFECT_CLASS_READ_ONLY",
      "localExec": {
        "command": "bun",
        "entrypoint": "./goal_get.ts"
      },
      "egress": [
        {
          "binding": "csod",
          "host": "{subdomain}.csod.com",
          "methods": [
            "GET"
          ],
          "pathPrefixes": [
            "/services/api/Goals"
          ]
        }
      ]
    },
    {
      "name": "goal_create",
      "description": "Create a goal. Asks first.",
      "inputSchemaJson": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"description\":\"Request body\"}},\"required\":[\"body\"],\"additionalProperties\":true}",
      "outputSchemaJson": "{\"type\":\"object\"}",
      "sideEffect": "SIDE_EFFECT_CLASS_MUTABLE_EXTERNAL",
      "localExec": {
        "command": "bun",
        "entrypoint": "./goal_create.ts"
      },
      "egress": [
        {
          "binding": "csod",
          "host": "{subdomain}.csod.com",
          "methods": [
            "POST"
          ],
          "pathPrefixes": [
            "/services/api/Goals"
          ]
        }
      ],
      "approvalRequired": true
    },
    {
      "name": "goal_update",
      "description": "Update a goal. Asks first.",
      "inputSchemaJson": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"description\":\"Request body\"}},\"required\":[\"body\"],\"additionalProperties\":true}",
      "outputSchemaJson": "{\"type\":\"object\"}",
      "sideEffect": "SIDE_EFFECT_CLASS_MUTABLE_EXTERNAL",
      "localExec": {
        "command": "bun",
        "entrypoint": "./goal_update.ts"
      },
      "egress": [
        {
          "binding": "csod",
          "host": "{subdomain}.csod.com",
          "methods": [
            "PUT"
          ],
          "pathPrefixes": [
            "/services/api/Goals"
          ]
        }
      ],
      "approvalRequired": true
    },
    {
      "name": "goal_update_progress",
      "description": "Update goal progress. Asks first.",
      "inputSchemaJson": "{\"type\":\"object\",\"properties\":{\"body\":{\"type\":\"object\",\"description\":\"Request body\"}},\"required\":[\"body\"],\"additionalProperties\":true}",
      "outputSchemaJson": "{\"type\":\"object\"}",
      "sideEffect": "SIDE_EFFECT_CLASS_MUTABLE_EXTERNAL",
      "localExec": {
        "command": "bun",
        "entrypoint": "./goal_update_progress.ts"
      },
      "egress": [
        {
          "binding": "csod",
          "host": "{subdomain}.csod.com",
          "methods": [
            "PUT"
          ],
          "pathPrefixes": [
            "/services/api/Goals"
          ]
        }
      ],
      "approvalRequired": true
    }
  ]
}
