{
  "resourceId": {
    "urn": "urn:vam:skill:hub.squrell.cloud/squrell/zendesk-tickets"
  },
  "version": {
    "major": 1,
    "minor": 0,
    "patch": 0
  },
  "description": "Search and read the company's Zendesk tickets as the member; create a ticket only with their approval",
  "requiresConnector": "urn:vam:connector:hub.squrell.cloud/squrell/zendesk",
  "tools": [
    {
      "name": "ticket_search",
      "description": "Searches tickets with Zendesk's search syntax (for example `status:open printer`). Returns id, subject, status, priority, update time and a short description for each match.",
      "inputSchemaJson": "{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"}},\"required\":[\"query\"]}",
      "outputSchemaJson": "{\"type\":\"object\",\"properties\":{\"count\":{\"type\":\"integer\"},\"tickets\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"integer\"},\"subject\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"priority\":{\"type\":\"string\"},\"updatedAt\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"}}}}},\"required\":[\"tickets\"]}",
      "sideEffect": "SIDE_EFFECT_CLASS_READ_ONLY",
      "localExec": {
        "command": "bun",
        "entrypoint": "./ticket_search.ts"
      },
      "egress": [
        {
          "binding": "api",
          "host": "{subdomain}.zendesk.com",
          "methods": [
            "GET"
          ],
          "pathPrefixes": [
            "/api/v2/search.json"
          ]
        }
      ],
      "ui": {
        "show": "ticket_list"
      }
    },
    {
      "name": "ticket_show",
      "description": "Shows one ticket by the numeric id ticket_search returned.",
      "inputSchemaJson": "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"integer\"}},\"required\":[\"id\"]}",
      "outputSchemaJson": "{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"integer\"},\"subject\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"priority\":{\"type\":\"string\"},\"updatedAt\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"}}}",
      "sideEffect": "SIDE_EFFECT_CLASS_READ_ONLY",
      "localExec": {
        "command": "bun",
        "entrypoint": "./ticket_show.ts"
      },
      "egress": [
        {
          "binding": "api",
          "host": "{subdomain}.zendesk.com",
          "methods": [
            "GET"
          ],
          "pathPrefixes": [
            "/api/v2/tickets/"
          ]
        }
      ]
    },
    {
      "name": "ticket_create",
      "description": "Creates a ticket (subject and first comment). Always asks the member first.",
      "inputSchemaJson": "{\"type\":\"object\",\"properties\":{\"subject\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"},\"priority\":{\"type\":\"string\"}},\"required\":[\"subject\",\"body\"]}",
      "outputSchemaJson": "{\"type\":\"object\",\"properties\":{\"created\":{\"type\":\"boolean\"},\"id\":{\"type\":\"integer\"},\"subject\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"}},\"required\":[\"created\"]}",
      "sideEffect": "SIDE_EFFECT_CLASS_MUTABLE_EXTERNAL",
      "approvalRequired": true,
      "localExec": {
        "command": "bun",
        "entrypoint": "./ticket_create.ts"
      },
      "egress": [
        {
          "binding": "api",
          "host": "{subdomain}.zendesk.com",
          "methods": [
            "POST"
          ],
          "paths": [
            "/api/v2/tickets.json"
          ]
        }
      ]
    }
  ]
}
