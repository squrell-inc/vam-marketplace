{
  "version": 1,
  "catalog": "vam/1",
  "root": "root",
  "state": { "boardId": "", "itemName": "", "groupId": "" },
  "nodes": {
    "root": {
      "type": "Stack",
      "props": { "gap": "medium" },
      "children": ["in_name", "in_board", "in_group", "row"]
    },
    "in_name": { "type": "Input", "props": { "label": "Item name", "value": { "$state": "itemName" } } },
    "in_board": { "type": "Input", "props": { "label": "Board ID", "value": { "$state": "boardId" } } },
    "in_group": { "type": "Input", "props": { "label": "Group ID (optional)", "value": { "$state": "groupId" } } },
    "row": {
      "type": "Stack",
      "props": { "direction": "horizontal", "gap": "small" },
      "children": ["ok", "no"]
    },
    "ok": {
      "type": "Button",
      "props": {
        "label": "Create item",
        "tone": "success",
        "action": { "event": "submit", "with": ["boardId", "itemName", "groupId"], "set": { "decision": "approve" } }
      }
    },
    "no": {
      "type": "Button",
      "props": {
        "label": "Deny",
        "tone": "danger",
        "action": { "event": "submit", "with": [], "set": { "decision": "deny" } }
      }
    }
  }
}
